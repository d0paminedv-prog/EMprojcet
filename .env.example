# ───────── 입장 ─────────
# 팀원에게 공유할 입장 코드 (비워 두면 「2심전심」)
ENTRY_CODE=2심전심

# 입장 쿠키 서명용 비밀키 — Vercel 배포 시 필수 (16자 이상 임의 문자열). 예: openssl rand -base64 32
AUTH_SECRET=

# ───────── 데이터베이스 ─────────
# Vercel Storage 탭에서 Neon(Postgres)을 연결하면 자동으로 추가됩니다.
# 로컬 개발에서 비워 두면 내장 DB(PGlite, .data/pglite)를 사용합니다.
DATABASE_URL=

# ───────── 실시간 동기화 (Liveblocks 무료 플랜) ─────────
# https://liveblocks.io 가입 → 프로젝트 생성 → API keys 의 Secret key (sk_...)
LIVEBLOCKS_SECRET_KEY=
# 로컬 개발 서버(npx liveblocks dev)를 쓸 때만: LIVEBLOCKS_SECRET_KEY=sk_localdev, LIVEBLOCKS_BASE_URL=http://localhost:1153
# LIVEBLOCKS_BASE_URL=

# ───────── 파일 저장소 ─────────
# Vercel Storage 탭에서 Blob 스토어(Private)를 연결하면 BLOB_STORE_ID 가 자동으로 추가됩니다(OIDC 방식, 토큰 불필요).
# 예전 방식의 BLOB_READ_WRITE_TOKEN 도 지원합니다. 로컬은 둘 다 비워 두면 .data/uploads 사용
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# Blob 스토어를 Public 으로 만들었다면 public
# BLOB_ACCESS=private

# ───────── Figma (선택, 없어도 됨) ─────────
# 공유 링크만으로 미리보기가 동작합니다. 썸네일·최종 수정 시각까지 보려면 개인 액세스 토큰(file_content:read)을 넣으세요.
# FIGMA_TOKEN=

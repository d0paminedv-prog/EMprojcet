# ───────── 필수 (Vercel 배포 시) ─────────
# Postgres 연결 문자열 — Vercel Storage 탭에서 Neon을 연결하면 자동으로 추가됩니다.
# 로컬 개발에서는 비워 두면 내장 DB(PGlite, .data/pglite)를 사용합니다.
DATABASE_URL=

# 로그인 세션 서명용 비밀키 (16자 이상 임의 문자열). 예: openssl rand -base64 32
AUTH_SECRET=

# 팀 초대 코드 — 팀원이 처음 로그인할 때 이 코드를 입력하고 개인 비밀번호를 만듭니다.
# (로컬 개발에서 비워 두면 team1234)
TEAM_PASSWORD=

# 처음 실행할 때 생성할 팀원 이름 (쉼표로 구분, 이후에는 「팀」 화면에서 관리)
TEAM_MEMBERS=김민지,이준호,박서연,최유진,정다은

# ───────── 파일 저장소 ─────────
# Vercel Storage 탭에서 Blob 스토어를 연결하면 자동으로 추가됩니다. (로컬은 비워 두면 .data/uploads 사용)
BLOB_READ_WRITE_TOKEN=
# Blob 스토어를 Public으로 만들었다면 public (기본: private 권장)
# BLOB_ACCESS=private

# ───────── AI 회의록 정리 (Claude) ─────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 모델 변경 시에만 설정 (기본: claude-opus-5-5)
# ANTHROPIC_MODEL=
